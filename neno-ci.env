export OPENMRS_IMAGE_NAME=partnersinhealth/pihmalawi-emr
export SEED_IMAGE_NAME=partnersinhealth/pihmalawi-emr-seed-malawi
export DISTRO_SOURCE_DIR="$(pwd)"

# Attaches the petl ETL service (profiled/on-demand -- run via `openmrs-docker <name> run-service
# petl`) and generates a fallback warehouse-connection.properties so warehouse-backed reports
# work locally. See README.md's "Using Docker" section for the compose-override copy step this
# also requires.
export SERVICES=openmrs-db,openmrs,petl
export PETL_IMAGE_NAME=partnersinhealth/apzu-etl
export PETL_FULL_REFRESH_JOBS=refresh-mysql-reporting.yml
export PETL_MYSQL_ROOT_PASSWORD=openmrs
export OMRS_EXTRA_pihmalawi_warehouse_connection_url="jdbc:mysql://openmrs-db:3306/openmrs_warehouse?autoReconnect=true&useUnicode=true&characterEncoding=UTF-8"
export OMRS_EXTRA_pihmalawi_warehouse_connection_username=openmrs
export OMRS_EXTRA_pihmalawi_warehouse_connection_password=openmrs
