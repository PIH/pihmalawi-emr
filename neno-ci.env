export OPENMRS_IMAGE_NAME=partnersinhealth/pihmalawi-emr
export OPENMRS_DISTRO_DIR="$(pwd)"

# Values for the petl ETL service (on-demand -- run via `openmrs-docker <name> run-service petl`,
# added with `create --services=openmrs-db,openmrs,petl`) and a fallback
# warehouse-connection.properties so warehouse-backed reports work locally. `create` writes them
# into the instance's own files.
export PETL_IMAGE_NAME=partnersinhealth/apzu-etl
export PETL_FULL_REFRESH_JOBS=refresh-mysql-reporting.yml
export PETL_MYSQL_PASSWORD=openmrs
export PETL_MYSQL_REPORTING_DATABASE=openmrs_warehouse
export OMRS_EXTRA_pihmalawi_warehouse_connection_url="jdbc:mysql://openmrs-db:3306/openmrs_warehouse?autoReconnect=true&useUnicode=true&characterEncoding=UTF-8"
export OMRS_EXTRA_pihmalawi_warehouse_connection_username=petl
export OMRS_EXTRA_pihmalawi_warehouse_connection_password="$PETL_MYSQL_PASSWORD"
