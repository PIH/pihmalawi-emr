<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.pih.openmrs</groupId>
		<artifactId>pihmalawi-emr</artifactId>
		<version>9.2.0-SNAPSHOT</version>
	</parent>

	<groupId>org.openmrs.module</groupId>
	<artifactId>pihmalawi-omod</artifactId>
	<packaging>jar</packaging>
	<name>PIH Malawi Customizations OMOD</name>
	<description>OpenMRS module project for PIH Malawi Customizations</description>

	<properties>
		<!-- The module's own identity, independent of the parent reactor's coordinates -->
		<MODULE_ID>pihmalawi</MODULE_ID>
		<MODULE_NAME>PIH Malawi</MODULE_NAME>
		<MODULE_VERSION>${project.parent.version}</MODULE_VERSION>
		<MODULE_PACKAGE>org.openmrs.module.pihmalawi</MODULE_PACKAGE>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.openmrs.module</groupId>
			<artifactId>pihmalawi-api</artifactId>
			<version>${project.parent.version}</version>
            <scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>org.openmrs.web</groupId>
			<artifactId>openmrs-web</artifactId>
			<version>${openMRSVersion}</version>
			<type>jar</type>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.openmrs.web</groupId>
			<artifactId>openmrs-web</artifactId>
			<version>${openMRSVersion}</version>
			<type>jar</type>
			<scope>test</scope>
			<classifier>tests</classifier>
