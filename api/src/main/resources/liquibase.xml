	<changeSet id="20240105-add-authentication-event-log" author="mseaton">
		<preConditions onFail="MARK_RAN">
			<not><tableExists tableName="authentication_event_log"/></not>
		</preConditions>
		<createTable tableName="authentication_event_log">
			<column name="login_id" type="char(36)">
				<constraints nullable="false"/>
			</column>
			<column name="event_datetime" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="ip_address" type="varchar(40)"/>
			<column name="http_session_id" type="varchar(32)"/>
			<column name="event_type" type="varchar(50)"/>
			<column name="username" type="varchar(50)"/>
			<column name="user_id" type="int"/>
			<column name="scheme_id" type="varchar(50)"/>
		</createTable>
	</changeSet>

	<changeSet id="20260414-add-authentication-event-log-index-1" author="mseaton">
		<preConditions onFail="MARK_RAN">
			<not><indexExists indexName="authentication_event_log_ui"/></not>
		</preConditions>
		<comment>Add index to authentication_event_log on user_id</comment>
		<createIndex indexName="authentication_event_log_ui" tableName="authentication_event_log">
			<column name="user_id"/>
		</createIndex>
	</changeSet>

	<changeSet id="20260414-add-authentication-event-log-index-2" author="mseaton">
		<preConditions onFail="MARK_RAN">
			<not><indexExists indexName="authentication_event_log_ui_et"/></not>
		</preConditions>
		<comment>Add composite index to authentication_event_log on user_id and event_type</comment>
		<createIndex indexName="authentication_event_log_ui_et" tableName="authentication_event_log">
			<column name="user_id"/>
			<column name="event_type"/>
		</createIndex>
	</changeSet>

	<changeSet id="20190618-map-pih-and-ciel-and-pihmalawi-concepts" author="jmbabazi">
		<comment>
			IS-392, Create concept mapping View at startup
		</comment>
		<sql>
			create view report_mapping as
			select crm.concept_id, crs.name "source", crt.code
			from concept_reference_map crm, concept_reference_term crt, concept_reference_source crs
			where crm.concept_reference_term_id = crt.concept_reference_term_id
			and crt.concept_source_id = crs.concept_source_id
			and crt.retired = 0
			and crs.retired = 0
			and crs.name in ('PIH','CIEL','PIH Malawi');
		</sql>
	</changeSet>

