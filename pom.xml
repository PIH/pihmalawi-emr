<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.pih.openmrs</groupId>
	<artifactId>pihmalawi-emr</artifactId>
	<version>9.2.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>PIH Malawi EMR</name>
	<description>Parent project for the PIH Malawi EMR distribution</description>
	<url>http://openmrs.org</url>

	<scm>
		<connection>scm:git:https://github.com/PIH/openmrs-module-pihmalawi.git</connection>
		<developerConnection>scm:git:https://github.com/PIH/openmrs-module-pihmalawi.git</developerConnection>
		<url>https://github.com/PIH/openmrs-module-pihmalawi/</url>
	  <tag>HEAD</tag>
  </scm>

    <distributionManagement>
        <repository>
            <id>openmrs-repo-modules-pih</id>
            <name>Modules</name>
            <url>https://openmrs.jfrog.io/artifactory/modules-pih</url>
        </repository>
        <snapshotRepository>
            <id>openmrs-repo-modules-pih</id>
            <name>OpenMRS Snapshots</name>
            <url>https://openmrs.jfrog.io/artifactory/modules-pih-snapshots</url>
        </snapshotRepository>
    </distributionManagement>

	<modules>
		<module>api</module>
		<module>omod</module>
		<module>content</module>
        <module>distro</module>
	</modules>

	<properties>
        <openMRSVersion>2.8.7</openMRSVersion>
        <addresshierarchyVersion>3.0.0-SNAPSHOT</addresshierarchyVersion>
        <appframeworkVersion>2.19.0</appframeworkVersion>
        <appuiVersion>1.18.0</appuiVersion>
		<authenticationVersion>2.3.0</authenticationVersion>
		<authenticationuiVersion>1.3.0</authenticationuiVersion>
        <calculationVersion>2.0.0</calculationVersion>
        <coreappsVersion>3.4.0</coreappsVersion>
        <emrapiVersion>3.4.0</emrapiVersion>
        <eventVersion>4.0.0</eventVersion>
		<fhir2Version>4.2.0</fhir2Version>
        <frontendVersion>1.42.0-SNAPSHOT</frontendVersion>
		<htmlformentryVersion>7.2.1</htmlformentryVersion>
		<htmlformentryuiVersion>3.2.0</htmlformentryuiVersion>
        <htmlwidgetsVersion>2.0.1</htmlwidgetsVersion>
        <idgenVersion>5.0.4</idgenVersion>
		<initializerVersion>2.12.0</initializerVersion>
        <legacyuiVersion>2.2.0</legacyuiVersion>
        <metadatamappingVersion>2.0.0</metadatamappingVersion>
        <namephoneticsVersion>1.19.0</namephoneticsVersion>
        <owaVersion>1.15.0</owaVersion>
        <registrationappVersion>1.29.0</registrationappVersion>
        <registrationcoreVersion>1.13.0</registrationcoreVersion>
		<reportingcompatibilityVersion>2.11.0</reportingcompatibilityVersion>
        <reportingVersion>2.1.0</reportingVersion>
        <reportingrestVersion>2.0.0</reportingrestVersion>
        <reportinguiVersion>1.14.0</reportinguiVersion>
        <serializationxstreamVersion>0.3.0</serializationxstreamVersion>
		<spaVersion>2.1.0</spaVersion>
        <testutilsVersion>1.7.0</testutilsVersion>
        <uicommonsVersion>3.1.0</uicommonsVersion>
        <uiframeworkVersion>4.0.0</uiframeworkVersion>
        <uilibraryVersion>2.0.7</uilibraryVersion>
        <webservicesRestVersion>3.4.1</webservicesRestVersion>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.javadoc.failOnError>false</maven.javadoc.failOnError>
	</properties>

	<build>
		<plugins>
			<!-- Provide ability to auto-update dependencies as appropriate -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
				<version>2.1</version>
				<configuration>
					<generateBackupPoms>false</generateBackupPoms>
					<properties>
						<property>
							<name>openMRSVersion</name>
							<version>[2.8.0,2.8.999)</version>
						</property>
					</properties>
				</configuration>
			</plugin>
		</plugins>

		<pluginManagement>
			<plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.1.1</version>
                    <configuration>
                        <tagNameFormat>@{project.version}</tagNameFormat>
                        <projectVersionPolicyId>SemVerVersionPolicy</projectVersionPolicyId>
                        <arguments>-DskipTests</arguments>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>2.10.3</version>
                </plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<target>1.8</target>
						<source>1.8</source>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.openmrs.maven.plugins</groupId>
					<artifactId>maven-openmrs-plugin</artifactId>
					<version>1.0.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-dependency-plugin</artifactId>
					<version>2.4</version>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<configuration>
						<includeEmptyDirs>true</includeEmptyDirs>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>2.22.1</version>
					<configuration>
						<parallel>false</parallel>
						<!-- Some tests are locale specific -->
						<argLine>-Duser.language=en -Duser.region=US</argLine>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<executions>
						<execution>
							<goals>
								<goal>test-jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<repositories>
		<repository>
			<id>openmrs-repo</id>
			<name>OpenMRS Nexus Repository</name>
			<url>https://openmrs.jfrog.io/artifactory/public</url>
		</repository>
		<repository>
			<id>ossrh</id>
			<url>https://oss.sonatype.org/content/repositories/public</url>
		</repository>
		<repository>
			<id>mks-repo</id>
			<name>Mekom Solutions Maven repository</name>
			<url>https://nexus.mekomsolutions.net/repository/maven-public</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>openmrs-repo</id>
			<name>OpenMRS Nexus Repository</name>
			<url>https://openmrs.jfrog.io/artifactory/public</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
		<pluginRepository>
			<id>openmrs-repo-snapshots</id>
			<name>OpenMRS Snapshots Repo</name>
			<url>https://openmrs.jfrog.io/artifactory/snapshots</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

</project>
