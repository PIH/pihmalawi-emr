{
  "@openmrs/esm-api": {
    "redirectAuthFailure": {
      "url": "${openmrsBase}/authenticationui/login/login.page"
    }
  },
  "@openmrs/esm-login-app": {
    "logo": {
      "src": "${openmrsSpaBase}/pih_apzu_logo_white.png",
      "alt": "Abwenzi Pa Za Umoyo",
      "name": "Abwenzi Pa Za Umoyo"
    },
    "links": {
      "loginSuccess": "${openmrsBase}/findPatient.htm"
    },
    "provider": {
      "type": "custom",
      "loginUrl": "${openmrsBase}/index.htm",
      "logoutUrl": "${openmrsBase}/appui/header/logout.action"
    }
  },
  "@openmrs/esm-form-builder-app": {
    "showSchemaSaveWarning": false
  },
  "@openmrs/esm-help-menu-app": {
    "extensionSlots": {
      "help-menu-slot": {
        "remove": [
          "release-notes", "docs", "contact-us", "tutorials"
        ]
      }
    }
  },
  "@openmrs/esm-home-app": {
    "extensionSlots": {
      "homepage-dashboard-slot": {
        "order": [
          "home-widget-db-link",
          "audit-dashboard-link"
        ]
      }
    },
    "leftNavMode": "hidden"
  },
  "@openmrs/esm-patient-vitals-app": {
    "concepts": {
      "systolicBloodPressureUuid": "6569bffe-977f-11e1-8993-905e29aff6c1",
      "diastolicBloodPressureUuid": "6569c116-977f-11e1-8993-905e29aff6c1",
      "pulseUuid": "6569c224-977f-11e1-8993-905e29aff6c1",
      "temperatureUuid": "6569c33c-977f-11e1-8993-905e29aff6c1",
      "oxygenSaturationUuid": "6569c792-977f-11e1-8993-905e29aff6c1",
      "heightUuid": "6569c562-977f-11e1-8993-905e29aff6c1",
      "weightUuid": "6569c44a-977f-11e1-8993-905e29aff6c1",
      "respiratoryRateUuid": "656ab86e-977f-11e1-8993-905e29aff6c1",
      "generalPatientNoteUuid": "65710548-977f-11e1-8993-905e29aff6c1",
      "midUpperArmCircumferenceUuid": "6558d09a-977f-11e1-8993-905e29aff6c1",
      "bodyMassIndexUuid": "655d615a-977f-11e1-8993-905e29aff6c1",
      "vitalSignsConceptSetUuid": "6557a044-977f-11e1-8993-905e29aff6c1"
    },
    "vitals": {
      "encounterTypeUuid": "664b82cc-977f-11e1-8993-905e29aff6c1"
    }
  },
  "@pihmalawi/esm-emastercards-app": {
    "extensionSlots": {
      "pihmalawi-vitals-header-slot": {
        "add": [
          "pihmalawi-latest-vitals",
          "pihmalawi-hiv-summary"
        ]
      }
    }
  },
  "@openmrs/esm-patient-chart-app": {
    "visitAttributeTypes": [],
    "extensionSlots": {
      "patient-info-slot": {
        "remove": [
          "patient-vitals-info"
        ]
      },
      "patient-chart-summary-dashboard-slot": {
        "add": [
          "programs-overview-widget"
        ],
        "remove": [
          "vitals-overview-widget",
          "biometrics-overview-widget"
        ]
      }
    }
  },
  "@openmrs/esm-patient-programs-app": {
    "showProgramStatusField": true
  },
  "@openmrs/esm-primary-navigation-app": {
    "logo": {
      "src": "${openmrsSpaBase}/pih_apzu_logo_white.png",
      "alt": "Abwenzi Pa Za Umoyo",
      "name": "Abwenzi Pa Za Umoyo",
      "link": "${openmrsBase}/findPatient.htm"
    },
    "extensionSlots": {
      "app-menu-slot": {
        "remove": [
          "dispensing-link",
          "forms-app-link",
          "offline-tools-link",
          "system-administration-app-menu-link"
        ]
      },
      "top-nav-actions-slot": {
        "remove": [
          "implementer-tools-button",
          "patient-search-icon"
        ]
      },
      "top-nav-app-menu-slot": {
        "remove": [
          "app-menu-button"
        ]
      },
      "user-panel-slot": {
        "remove": [
          "offline-tools-opt-in-offline-mode-button"
        ]
      }
    }
  },
  "@openmrs/esm-styleguide": {
    "Brand color #1": "#FB9500",
    "Brand color #2": "#FB9500",
    "Brand color #3": "#D87100"
  },
  "@openmrs/esm-patient-search-app": {
    "extensionSlots": {
      "start-visit-button-slot2": {
        "remove": [
          "patient-search-start-visit-button"
        ]
      },
      "patient-search-actions-slot": {
        "remove": [
          "add-past-visit-button",
          "cancel-visit-button",
          "edit-patient-details-button",
          "stop-visit-button-patient-search"
        ]
      }
    }
  },
  "@openmrs/esm-patient-registration-app": {
    "links": {
      "submitButton": "${openmrsBase}/patientDashboard.form?patientId=${patientUuid}"
    },
    "fieldConfigurations": {
      "gender": [
        { "value": "male", "label": "Male" },
        { "value": "female", "label": "Female" }
      ],
      "name": {
        "displayCapturePhoto": false,
        "allowUnidentifiedPatients": false
      },
      "address": {
        "useAddressHierarchy": {
          "enabled": true,
          "useQuickSearch": true,
          "searchAddressByLevel": true
        }
      },
      "causeOfDeath": {
        "conceptUuid": "6569569a-977f-11e1-8993-905e29aff6c1",
        "required": true
      },
      "identifier": {
        "allowPreferredSelection": true
      }
    },
    "freeTextFieldConceptUuid": "656cce7e-977f-11e1-8993-905e29aff6c1",
    "defaultPatientIdentifierTypes": [
      "66784d84-977f-11e1-8993-905e29aff6c1",
      "11a76c3e-1db8-4d16-9252-9a18b5ed1843",
      "f7de1b97-013e-49ad-a596-4ada6ede1053"
    ],
    "sections": ["demographics", "death"],
    "fieldDefinitions": [
        {
          "id": "healthCenter",
          "type": "person attribute",
          "uuid": "8d87236c-c2cc-11de-8d13-0010c6dffd0f",
          "label": "Health Center",
          "locationTag": "Login Location"
        }
    ],
    "sectionDefinitions": [
        {
          "id": "demographics",
          "name": "Basic Info",
          "fields": ["name", "gender", "dob", "address", "id", "healthCenter"]
        },
        { 
          "id": "death", 
          "name": "Deceased", 
          "fields": ["dateAndTimeOfDeath", "causeOfDeath"] 
        }        
    ],
    "Translation overrides": {
      "en": {
        "stateProvince": "District",
        "countyDistrict": "Traditional Authority",
        "cityVillage": "Village"        
      }
    }
  }
}