hadArtFollowup=[ART_FOLLOWUP|sinceDate=${report.startDate}|untilDate=${report.endDate}]

hadArtEncounter=#hadArtInitial# OR #hadArtFollowup#

artRegLastWeek=[REGISTRATION|location=9|withinLastDays=7]
artRegTwoWeeks=[REGISTRATION|location=9|withinLastDays=14]
artRegWeekAgo=#artRegTwoWeeks# NOT #artRegLastWeek#

artAptLastWeek=[APPOINTMENT|location=9|withinLastDays=7]
artAptTwoWeeks=[APPOINTMENT|location=9|withinLastDays=14]
artAptWeekAgo=#artAptTwoWeeks# NOT #artAptLastWeek#

artScanWeekAgo = #artRegWeekAgo# OR #artAptWeekAgo#
anyHIV = [Patients in HIV Program] OR [EID Program] OR [KS Program]

artVisitNotEnrolled = #artScanWeekAgo# NOT #anyHIV#</value>
