	<script src="/openmrs/moduleResources/pihmalawi/htmlform_common.js"
		type="text/javascript"></script>
	<table>
		<tr>
			<th colspan="2" align="left">
				Child Details
			</th>
		</tr>
		<tr>
			<td>Child Name</td>
			<td>
				<lookup expression="patient.personName" />
				(
				<lookup
					complexExpression="#foreach( $id in $patientIdentifiers.get(&quot;HCC Number&quot;) ) $!id #end" />
				)
				(
				<lookup
					complexExpression="#foreach( $id in $patientIdentifiers.get(&quot;ARV Number&quot;) ) $!id #end" />
				)
			</td>
		</tr>
		<tr>
			<td>Sex, Birthdate</td>
			<td>
				<lookup expression="patient.gender" />
				,
				<lookup expression="patient.birthdate" />
			</td>
		</tr>
		<tr>
			<td>Addresses</td>
			<td>
				<lookup
					complexExpression="#foreach( $addr in $patient.addresses) $!addr.getAddress1() $!addr.getCityVillage() $!addr.getStateProvince() $!addr.getCountyDistrict(), #end" />
			</td>
		</tr>
		<tr style="display:none">
			<!-- Location isn't needed here, just hide it -->
			<td>Location</td>
			<td>
				<encounterLocation default="8d6c993e-c2cc-11de-8d13-0010c6dffd0f" />
			</td>
		</tr>
		<tr style="display:none">
			<!-- Provider is close to useless for us, so just hide it -->
			<td>Provider</td>
			<td>
				<encounterProvider default="c4f0fc3c-2695-102d-b4c2-001d929acb54" />
			</td>
		</tr>
		<tr style="display:none">
			<!-- Date isn't needed here, just hide it -->
			<td>Date</td>
			<td>
				<encounterDate default="today" />
			</td>
		</tr>
		<tr>
			<td>Current outcome</td>
			<td>
				<!-- Was hardcoded to workflow id 1, which in this instance resolves to the unrelated Chronic
				     Care Program's Asthma treatment workflow (copy-paste leftover). This form is explicitly
				     "for Exposed Children" (HCC Number + ARV Number identifiers), so switched to the
				     UUID-based overload of currentProgramWorkflowStatus, referencing the actual Early Infant
				     Diagnosis Program's "Patient status" workflow (same program exposed-child-emastercard.xml
				     is for). -->
				'
				<lookup
					expression="fn.currentProgramWorkflowStatus('66870234-977f-11e1-8993-905e29aff6c1').getState().getConcept().getName().getName()" />
				'
				(since
				<lookup expression="fn.currentProgramWorkflowStatus('66870234-977f-11e1-8993-905e29aff6c1').getStartDate()" />
				)
			</td>
		</tr>
	</table>
