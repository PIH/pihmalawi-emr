<htmlform
        htmlformUuid="76d9a420-e78f-11e0-baeb-445f1136dfb9"
        formUuid="d3869141-c3e9-45d4-b25b-354aa6802ff2"
        formName="z_deprecated_Pre-ART Visit"
        formDescription=""
        formVersion="1"
        formEncounterType="664b8812-977f-11e1-8993-905e29aff6c1"
        formPublished="false"
        formRetired="true"
>

	<!-- Note: Provider entry field his hidden -->
	<table>
		<tr>
			<!-- Provider is close to useless for us, so just hide it -->
			<td style="display:none">Provider</td>
			<td style="display:none">
				<encounterProvider default="c4f0fc3c-2695-102d-b4c2-001d929acb54" />
			</td>
			<td>Clinic</td>
			<td>
				<encounterLocation />
			</td>
			<td>Current Outcome</td>
			<td>
				<lookup
					expression="fn.currentProgramWorkflowStatus(1, 1).getState().getConcept().getName().getName()" />
				(since <lookup expression="fn.currentProgramWorkflowStatus(1, 1).getStartDate()" />)
			</td>
		</tr>
	</table>
	<table>
		<tr>
			<td>Visit Date</td>
			<td>Height</td>
			<td>Weight</td>
			<td>Wasting/Malnutr.</td>
			<td>TB Status (Current)</td>
			<td>WHO Stage</td>
			<td colspan="2" align="center">
				CD4
				<table>
					<tr>
						<td>Sample taken</td>
						<td>Result</td>
					</tr>
				</table>
			</td>
			<td>Pregnant</td>
			<td>IPT # tablets</td>
			<td>CPT # tablets</td>
			<td colspan="2" align="center">
				Family Plan.
				<table>
					<tr>
						<td>Depo given</td>
						<td># condoms</td>
					</tr>
				</table>
			</td>
			<td>Side Effects</td>
			<td>Next appointment</td>
		</tr>
		<tr>
			<td>
				<!-- Visit date -->
				<encounterDate default="today" />
			</td>
			<td>
				<!-- Height -->
				<obs conceptId="6569c562-977f-11e1-8993-905e29aff6c1" />
			</td>
			<td>
				<!-- Weight -->
				<obs conceptId="6569c44a-977f-11e1-8993-905e29aff6c1" />
			</td>
			<td>
				<!-- Wasting/malnutrition -->
				<obs conceptId="657a2268-977f-11e1-8993-905e29aff6c1" style="radio" answerConceptIds="6557646c-977f-11e1-8993-905e29aff6c1,655c243e-977f-11e1-8993-905e29aff6c1,655c28b2-977f-11e1-8993-905e29aff6c1"
					answerLabels="No,Mod,Sev" />
			</td>
			<td style="white-space: nowrap;">
				<!-- TB status -->
				<obs conceptId="65770db2-977f-11e1-8993-905e29aff6c1" style="radio" answerConceptIds="6577084e-977f-11e1-8993-905e29aff6c1,65770966-977f-11e1-8993-905e29aff6c1,65770a7e-977f-11e1-8993-905e29aff6c1,65770ca4-977f-11e1-8993-905e29aff6c1"
					answerLabels="N,Y,C,Rx" />
			</td>
			<td style="white-space: nowrap;">
				<!-- WHO stage -->
				<obs conceptId="65778170-977f-11e1-8993-905e29aff6c1" style="radio" answerConceptIds="657499f6-977f-11e1-8993-905e29aff6c1,65749afa-977f-11e1-8993-905e29aff6c1,65749bfe-977f-11e1-8993-905e29aff6c1,65749d02-977f-11e1-8993-905e29aff6c1"
					answerLabels="1,2,3,4" />
			</td>
			<td>
				<!-- CD4 sample taken -->
				<!-- taken from DNA/PCR bleeding; not 100% correct for CD4, but at least 
					consistent to ART -->
				<obs conceptId="6566fcba-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="6566fcba-977f-11e1-8993-905e29aff6c1"
					answerLabel="Bled" />
			</td>
			<td>
				<!-- CD4 result -->
				<lookup
					complexExpression="
#set ($obs = false)
#set ($obs = $fn.earliestObs(3434))
#if (!$obs)
#set ($obsResult = 'N/A')
#set ($obsDate = 'N/A')
#else
#set ($obsdate = $obs.obsDatetime.toString())
#set ($year = $obsdate.substring(0,4))
#set ($month = $obsdate.substring(5,7))
#set ($date = $obsdate.substring(8,10))
#set ($obsResult = $obs.valueNumeric)
#set ($obsDate = &quot;${date}/${month}/${year}&quot;)
#end
&lt;input type='text' value='$obsResult' size='5' disabled='true' id='$prevCd4Value' /&gt; at &lt;input type='text' value='$obsDate' size='10' disabled='true' id='$prevCd4Date' /&gt;
" />
				<obs conceptId="6565b94a-977f-11e1-8993-905e29aff6c1" />
			</td>
			<td>
				<!-- pregnant -->
				<obs conceptId="656fbd28-977f-11e1-8993-905e29aff6c1" style="radio" answerConceptIds="6557646c-977f-11e1-8993-905e29aff6c1,65576354-977f-11e1-8993-905e29aff6c1"
					answerLabels="N,Y" />
			</td>
			<td>
				<!-- IPT -->
				<obs conceptId="657a2164-977f-11e1-8993-905e29aff6c1" />
			</td>
			<td>
				<!-- CPT -->
				<obs conceptId="6570b82c-977f-11e1-8993-905e29aff6c1" />
			</td>
			<td>
				<!-- depo given -->
				<obs conceptId="657a1e44-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="65576354-977f-11e1-8993-905e29aff6c1"
					answerLabel="" />
			</td>
			<td>
				<!-- # condoms -->
				<obs conceptId="657a52ce-977f-11e1-8993-905e29aff6c1" />
			</td>
			<td>
				<!-- side effects -->
				<obs conceptId="65789d4e-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="6557646c-977f-11e1-8993-905e29aff6c1"
					answerLabel="No" />
				<obs conceptId="65789d4e-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="654a4ade-977f-11e1-8993-905e29aff6c1"
					answerLabel="PN" />
				<obs conceptId="65789d4e-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="6545b33e-977f-11e1-8993-905e29aff6c1"
					answerLabel="HP" />
				<obs conceptId="65789d4e-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="65489e00-977f-11e1-8993-905e29aff6c1"
					answerLabel="SK" />
				<obs conceptId="65789d4e-977f-11e1-8993-905e29aff6c1" style="checkbox" answerConceptId="657140f8-977f-11e1-8993-905e29aff6c1"
					answerLabel="Oth" />
			</td>
			<td>
				<!-- Next appointment date -->
				<obs conceptId="6569cbd4-977f-11e1-8993-905e29aff6c1" allowFutureDates="true" />
			</td>
		</tr>
		<tr>
			<td colspan="14" align="left">
				<submit />
			</td>
		</tr>
	</table>

</htmlform>
