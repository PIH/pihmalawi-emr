   	<!--  Eclipse XML Code style messes around with embedded Javascript -->
	<script language="javascript" type="text/javascript">
		/* hack in the link to void encounters based on parsing the current url */
		/* seems only to work reliably in firefox */
		/* is hopefully fixed with later version of html form entry */
		var paramName = "encounterId";

		/* regex stuff to parse out url parameters */
		paramName = paramName.replace(/[\[]/,"\\\[").replace(/[\]]/,"\\\]");
		var regexS = "[\\?&amp;]"+paramName+"=([^&amp;#]*)";
		var regex = new RegExp(regexS );
		var results = regex.exec( window.location.href );
		if(results != null ) {
			paramValue = results[1];

			/* create openmrs url to go back to Dashboard */ 
			document.write(" &lt;a href=" + window.location.protocol + "//" + window.location.host + "/openmrs/patientDashboard.form?patientId=" + <lookup expression="patient.patientId"/> + "&gt;Cancel&lt;/a&gt;");

			/* create openmrs url to edit demographics */ http://127.0.0.1:8080/openmrs/admin/patients/newPatient.form?patientId=15889
			document.write(" &lt;a href=" + window.location.protocol + "//" + window.location.host + "/openmrs/admin/patients/newPatient.form?patientId=" + <lookup expression="patient.patientId"/> + "&gt;Edit demographics&lt;/a&gt;");

			/* create openmrs url to void encounter only if edit */
			document.write(" &lt;a href=" + window.location.protocol + "//" + window.location.host + "/openmrs/admin/encounters/encounter.form?encounterId=" + paramValue + "&gt;Void encounter&lt;/a&gt;");
		}
	</script>
