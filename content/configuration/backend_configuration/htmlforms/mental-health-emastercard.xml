                                    <table cellpadding="0" cellspacing="0" width="100%">
                                        <tr>
                                            <td style="border: 1px solid #ffffff;">
                                                <strong>Traditional<br/>medicine</strong>
                                            </td>
                                            <td style="border: 1px solid #ffffff;">
                                                <obs conceptId="$exposeHistory" style="radio" answerConceptIds="$current,$past,$never" answerLabels="Current,Past,Never" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" id="trad-time" style="border: 1px solid #ffffff;">
                                                <obs conceptId="$expoYears" labelText="# years"/>
                                                &amp;nbsp;&amp;nbsp;&amp;nbsp;
                                                <obs conceptId="$expoDate" labelText="Date last use" allowFutureDates="true"/>
                                            </td>
                                        </tr>
                                    </table>
                                </obsgroup>
                            </td>
                        </tr>

                        <tr>
                            <th style="vertical-align:top;" align="left" colspan="3">Outcome:
                                    <!-- Was hardcoded to workflow id 16, which in this instance resolves to the
                                         unrelated Early Infant Diagnosis Program's workflow (copy-paste leftover) and
                                         always rendered empty for Mental Health patients. Switched to the UUID-based
                                         overload of currentProgramWorkflowStatus, referencing the actual "Mental
                                         health treatment" workflow of the Mental Health Care Program. -->
                                    <lookup expression="fn.currentProgramWorkflowStatus('da69bbcb-01fe-4c59-9d46-8a2659abbd73').state.concept.name"/>
                                    (<lookup expression="fn.currentProgramWorkflowStatus('da69bbcb-01fe-4c59-9d46-8a2659abbd73').startDate"/>)
                            </th>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <ifMode mode="VIEW" include="false">
            <div id="buttons" style="margin-top:10px;">
                <button class="submitButton confirm" onclick="submitHtmlForm()">
                    <uimessage code="uicommons.save"/>
                    <i class="icon-spinner icon-spin icon-2x" style="display: none; margin-left: 10px;"></i>
                </button>
            </div>
        </ifMode>
    </div>

</htmlform>
